{% set accents = {
  'Opportunities': ('#B45309', '#FFF7ED', '#FDE9D2'),
  'Papers':        ('#4338CA', '#EEF2FF', '#E0E5FB'),
  'News':          ('#0369A1', '#F0F9FF', '#DDF0FB'),
  'Politics':      ('#475569', '#F8FAFC', '#E9EEF4')
} %}
<div style="background:#EEF0F3;padding:28px 12px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
  <div style="max-width:600px;margin:0 auto;">

    <!-- header band -->
    <div style="background:#0F172A;border-radius:16px 16px 0 0;padding:20px 24px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
        <td style="color:#FFFFFF;font-size:17px;font-weight:800;letter-spacing:5px;">SCOUT</td>
        <td align="right" style="color:#94A3B8;font-size:12px;font-weight:600;letter-spacing:1px;">WEEK OF {{ week_of|upper }}</td>
      </tr></table>
    </div>

    <!-- hero: the read of the week -->
    <div style="background:#FFFFFF;padding:22px 24px 18px;border:1px solid #E4E7EC;border-top:none;">
      <p style="margin:0;font-size:18px;line-height:1.45;font-weight:700;color:#0F172A;">{{ week_read }}</p>
    </div>

    {% for title, bullets in sections %}
    {% if bullets %}
    <div style="background:#FFFFFF;border:1px solid #E4E7EC;border-top:none;padding:18px 24px 10px;">
      <p style="margin:0 0 10px;font-size:11px;font-weight:800;letter-spacing:2px;color:#667085;">{{ title|upper }}</p>
      {% for b in bullets %}
      <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 8px;"><tr>
        <td style="vertical-align:top;padding:6px 10px 0 0;"><span style="display:inline-block;width:7px;height:7px;border-radius:999px;background:#0F172A;"></span></td>
        <td style="font-size:14px;line-height:1.55;color:#344054;">{{ b }}</td>
      </tr></table>
      {% endfor %}
    </div>
    {% endif %}
    {% endfor %}

    {% if top_items %}
    <div style="background:#FFFFFF;border:1px solid #E4E7EC;border-top:none;padding:18px 24px 8px;">
      <p style="margin:0 0 12px;font-size:11px;font-weight:800;letter-spacing:2px;color:#667085;">BEST OF THE WEEK</p>
      {% for t in top_items %}
      {% set accent = accents.get(t.section, ('#475569', '#F8FAFC', '#E9EEF4')) %}
      <div style="margin:0 0 10px;padding:14px 16px;background:{{ accent[1] }};border:1px solid {{ accent[2] }};border-radius:12px;">
        <p style="margin:0 0 4px;font-size:10.5px;font-weight:800;letter-spacing:1.5px;color:{{ accent[0] }};">{{ t.section|upper }}</p>
        <p style="margin:0 0 4px;font-size:15px;line-height:1.4;font-weight:700;color:#101828;">{{ t.title }}</p>
        <p style="margin:0;font-size:13.5px;line-height:1.5;color:#344054;">{{ t.why }}</p>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if read_of_week %}
    <div style="background:#FFFFFF;border:1px solid #E4E7EC;border-top:none;padding:18px 24px;">
      <p style="margin:0 0 10px;font-size:11px;font-weight:800;letter-spacing:2px;color:#667085;">&#128214;&nbsp;ONE GOOD READ</p>
      <div style="padding:14px 16px;background:#F6F5FF;border:1px solid #E4E0FA;border-radius:12px;">
        <a href="{{ read_of_week.url }}" style="font-size:15px;font-weight:700;color:#4338CA;text-decoration:none;">{{ read_of_week.title }}</a>
        <p style="margin:5px 0 0;font-size:13.5px;line-height:1.5;color:#344054;">{{ read_of_week.why }}</p>
      </div>
    </div>
    {% endif %}

    {% if deadline_note %}
    <div style="background:#FFF1F0;border:1px solid #FECDCA;border-top:none;padding:14px 24px;">
      <p style="margin:0;font-size:14px;line-height:1.5;color:#B42318;font-weight:600;">&#9200;&nbsp;{{ deadline_note }}</p>
    </div>
    {% endif %}

    <!-- footer -->
    <div style="background:#F8FAFC;border:1px solid #E4E7EC;border-top:1px dashed #E4E7EC;border-radius:0 0 16px 16px;padding:14px 24px;">
      {% for f in footer_lines %}
      <p style="margin:0 0 3px;font-size:12px;line-height:1.5;color:#98A2B3;">{{ f }}</p>
      {% endfor %}
      <p style="margin:6px 0 0;font-size:11px;color:#C3CAD5;">Scout &middot; the week, synthesised</p>
    </div>

  </div>
</div>
