<div style="max-width:600px;margin:0 auto;padding:24px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1a1a1a;line-height:1.5;background:#ffffff;">
  <p style="font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#999;margin:0 0 4px;">Scout &middot; Week of {{ week_of }}</p>
  <p style="font-size:17px;font-weight:600;margin:0 0 20px;color:#111;">{{ week_read }}</p>

  {% for title, bullets in sections %}
  {% if bullets %}
  <p style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#777;margin:22px 0 10px;border-bottom:1px solid #ececec;padding-bottom:5px;">{{ title }}</p>
  {% for b in bullets %}
  <p style="margin:0 0 8px;font-size:14px;color:#222;">{{ b }}</p>
  {% endfor %}
  {% endif %}
  {% endfor %}

  {% if top_items %}
  <p style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#777;margin:22px 0 10px;border-bottom:1px solid #ececec;padding-bottom:5px;">Best of the week</p>
  {% for t in top_items %}
  <div style="margin:0 0 14px;">
    <span style="font-size:11px;letter-spacing:1px;text-transform:uppercase;color:#8a6d3b;">{{ t.section }}</span>
    <p style="margin:2px 0 2px;font-size:15px;font-weight:600;color:#0b3d62;">{{ t.title }}</p>
    <p style="margin:0;font-size:14px;color:#222;">{{ t.why }}</p>
  </div>
  {% endfor %}
  {% endif %}

  {% if read_of_week %}
  <p style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#777;margin:22px 0 10px;border-bottom:1px solid #ececec;padding-bottom:5px;">One good read</p>
  <div style="margin:0 0 14px;">
    <a href="{{ read_of_week.url }}" style="font-size:15px;font-weight:600;color:#0b3d62;text-decoration:none;">{{ read_of_week.title }}</a>
    <p style="margin:4px 0 0;font-size:14px;color:#222;">{{ read_of_week.why }}</p>
  </div>
  {% endif %}

  {% if deadline_note %}
  <div style="border-left:3px solid #b03a2e;background:#fbf4f3;padding:10px 14px;margin:22px 0 0;">
    <p style="margin:0;font-size:14px;color:#222;">{{ deadline_note }}</p>
  </div>
  {% endif %}

  {% if footer_lines %}
  <div style="margin-top:26px;border-top:1px solid #ececec;padding-top:10px;">
    {% for f in footer_lines %}
    <p style="margin:0 0 3px;font-size:12px;color:#a5a5a5;">{{ f }}</p>
    {% endfor %}
  </div>
  {% endif %}
</div>
