<div style="max-width:600px;margin:0 auto;padding:24px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1a1a1a;line-height:1.5;background:#ffffff;">
  <p style="font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#999;margin:0 0 4px;">Scout {{ mode_label }} &middot; {{ date_str }}</p>
  <p style="font-size:17px;font-weight:600;margin:0 0 18px;color:#111;">{{ day_read }}</p>

  {% if reminders %}
  <div style="border-left:3px solid #b03a2e;background:#fbf4f3;padding:10px 14px;margin:0 0 22px;">
    <p style="margin:0 0 6px;font-size:11px;font-weight:700;letter-spacing:1px;color:#b03a2e;">DEADLINES</p>
    {% for r in reminders %}
    <p style="margin:0 0 4px;font-size:14px;color:#222;">{% if r.url %}<a href="{{ r.url }}" style="color:#222;font-weight:600;text-decoration:none;">{{ r.title }}</a>{% else %}<span style="font-weight:600;">{{ r.title }}</span>{% endif %} &mdash; {{ r.line }}</p>
    {% endfor %}
  </div>
  {% endif %}

  {% for tag, group in groups %}
  <p style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#777;margin:22px 0 10px;border-bottom:1px solid #ececec;padding-bottom:5px;">{{ tag }}</p>
    {% for item in group %}
    <div style="margin:0 0 18px;">
      <a href="{{ item.url }}" style="font-size:15px;font-weight:600;color:#0b3d62;text-decoration:none;">{{ item.title }}</a>
      <span style="font-size:11px;color:#b8b8b8;">&nbsp;{{ item.score }}</span>
      <p style="margin:4px 0 3px;font-size:14px;color:#222;">{{ item.why }}</p>
      <p style="margin:0;font-size:12px;color:#9a9a9a;">{{ item.source_label }} &middot; {{ item.date }}</p>
    </div>
    {% endfor %}
  {% endfor %}

  {% if not groups and quiet_body %}
  <p style="font-size:15px;margin:0 0 18px;color:#222;">{{ quiet_body }}</p>
  {% endif %}

  {% if quiet_lines %}
  <div style="margin:22px 0 0;">
    {% for q in quiet_lines %}
    <p style="margin:0 0 3px;font-size:13px;color:#8a6d3b;">{{ q }}</p>
    {% endfor %}
  </div>
  {% endif %}

  {% if footer_lines %}
  <div style="margin-top:26px;border-top:1px solid #ececec;padding-top:10px;">
    {% for f in footer_lines %}
    <p style="margin:0 0 3px;font-size:12px;color:#a5a5a5;">{{ f }}</p>
    {% endfor %}
  </div>
  {% endif %}
</div>
