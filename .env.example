# ============================================================================
# SCOUT — secrets. Copy this file to `.env` and fill it in.
#
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit it, never paste it anywhere.
# These values are sent ONLY to api.anthropic.com (the API key) and
# smtp.gmail.com (the email credentials). Nowhere else, ever.
# ============================================================================

# Your own Anthropic API key — create one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# The Gmail address Scout sends FROM and TO (both are you — Scout has no
# other recipients and will not accept one from anywhere).
EMAIL_ADDRESS=

# A Gmail APP PASSWORD — NOT your real Google password.
# How to make one (requires 2-Step Verification to be on):
#   Google Account -> Security -> 2-Step Verification -> App passwords
#   -> create one named "scout" -> paste the 16-character code here
#   (spaces don't matter).
EMAIL_APP_PASSWORD=
